# Camera sources - one line per camera, as CAM<N>_SOURCE.
# Each value is either a webcam index ("0", "1", ...) or an RTSP URL.
# Any number of cameras is supported - just add more CAM<N>_SOURCE lines.
CAM1_SOURCE=0
CAM2_SOURCE=rtsp://user:password@10.134.80.84:554/stream1
CAM3_SOURCE=rtsp://user:password@10.134.80.85:554/stream1

# Legacy single-camera fallback - only used if no CAM<N>_SOURCE vars are set above.
CAMERA_SOURCE=0
